# ---------- Core ----------
APP_NAME=SaathiGo
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./tagalong.db
# DATABASE_URL=postgresql+psycopg://tagalong:tagalong@localhost:5432/tagalong
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173"]
UPLOAD_DIR=uploads

# ---------- Business rules ----------
# Traveller who carries / brings an order earns this share of the product value
TRAVELLER_REWARD_PCT=0.20
# SaathiGo platform fee as a share of the product value
PLATFORM_FEE_PCT=0.02

# ---------- Shipping estimator ----------
# rate_card (built-in) | shiprocket (skeleton, fill in client)
SHIPPING_PROVIDER=rate_card

# ---------- Boarding pass OCR ----------
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
BOARDING_PASS_MIN_SCORE=60
# true = travellers must scan a boarding pass before carrying (off for the simple flow)
BOARDING_PASS_ENABLED=false

# ---------- Payments ----------
# mock (local demo checkout page) | pinelabs
PAYMENT_PROVIDER=mock
# uat | prod
PINELABS_ENV=uat
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
PINELABS_MERCHANT_ID=
# Webhook signing secret shared by Pine Labs (base64, may start with whsec_)
PINELABS_WEBHOOK_SECRET=

# ---------- Admins ----------
# Comma-separated emails that get the Saathi human-review queue (/review)
ADMIN_EMAILS=

# ---------- Saathi agents (Pine Labs AgenticOrg) ----------
# agenticorg | mock  (blank = agenticorg when an API key is set, else rule-based mock)
AGENT_PROVIDER=
AGENTICORG_API_KEY=
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
AGENTICORG_TIMEOUT_S=90
AGENT_CONCIERGE_ID=4459bfd0-2217-4675-ae00-62f5b2d4e828
AGENT_INTAKE_ID=43892aba-712a-4430-a30f-37ad3173d674
AGENT_DABBA_CURATOR_ID=1b9a33df-6bb0-4949-8d79-d487bae00bc0
AGENT_COMPLIANCE_ID=3af13765-0a70-4095-b95f-5ca50af326ea
AGENT_MATCHING_ID=9f7ec8b1-4f18-4c15-a259-9a107c160205
AGENT_NEGOTIATION_ID=88f00fe0-c6a5-4a2e-a842-e7e2f649b032
AGENT_TRACKING_SUPPORT_ID=bbfbb8b9-652f-4eaa-8e88-e8a52aeaf6dd
